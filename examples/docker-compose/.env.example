# Mailyard, Copyright (c) 2021-2026 YouSysAdmin
#
# Copy to .env beside docker-compose.yml and fill in. Compose refuses to
# start without the three marked required, rather than booting with an
# empty secret.

# Postgres password. Any long random string.
POSTGRES_PASSWORD=

# Signs session tokens. Every other HMAC in the system derives a
# per-purpose subkey from this one, never the raw value.
#
#   openssl rand -hex 32
MAILYARD_AUTH_JWT_SECRET=

# Seals the secrets stored IN the database: SMTP passwords, DKIM private
# keys, TOTP secrets, OAuth client secrets, certificate private keys.
#
# At least 32 characters. DO NOT LOSE IT - changing it orphans every row
# already sealed under the old one, and there is no recovery.
#
#   openssl rand -hex 32
MAILYARD_DATABASE_CRYPTO_ENCRYPTION_KEY=

# Bearer token for GET /metrics. Optional: the port is not published, so
# without one the endpoint is open to the container network only.
MAILYARD_METRICS_TOKEN=
